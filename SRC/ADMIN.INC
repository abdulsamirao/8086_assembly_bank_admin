.code

; Purpose: Authenticate an administrator, then run the account menu.
; Inputs: Validated data image in DATA_IMAGE.
; Outputs: AL=0 on normal exit or EOF, AL=2 on lockout, AL=4 on timeout.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: CMP, direct addressing, near CALL/RET, and conditional branches.
ADMIN_RUN PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    CALL ADMIN_LOGIN
    CMP AL, 0
    JE ADMIN_RUN_MENU
    CMP AL, 1
    JE ADMIN_RUN_EOF
    MOV AL, 2
    JMP ADMIN_RUN_RETURN
ADMIN_RUN_MENU:
    CMP SWITCH_KIND, 'T'
    JE ADMIN_RUN_MENU_START
    CALL ISR_INSTALL
ADMIN_RUN_MENU_START:
    CALL ADMIN_MENU
    CMP AL, 4
    JE ADMIN_RUN_TIMEOUT
    CALL ISR_RESTORE
    XOR AL, AL
    JMP ADMIN_RUN_RETURN
ADMIN_RUN_TIMEOUT:
    CALL ADMIN_TIMEOUT
    CALL ISR_RESTORE
    MOV DX, OFFSET MSG_SESSION_TIMEOUT
    CALL PRINT_STRING
    MOV AL, 4
    JMP ADMIN_RUN_RETURN
ADMIN_RUN_EOF:
    XOR AL, AL
ADMIN_RUN_RETURN:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_RUN ENDP

; Purpose: Perform up to three non-enumerating administrator credential checks.
; Inputs: Admin ID and PIN records are in DATA_IMAGE.
; Outputs: AL=0 accepted, AL=1 input EOF, AL=2 locked after three failures.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: REPE CMPSB, REP STOSB, and register-indirect addressing.
ADMIN_LOGIN PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV ADMIN_ATTEMPTS, 0
ADMIN_LOGIN_ATTEMPT:
    MOV DX, OFFSET MSG_ADMIN_ID
    CALL ADMIN_READ_ID
    MOV ADMIN_ID_STATUS, AL
    MOV SI, OFFSET ADMIN_ID_BUFFER
    MOV DI, OFFSET AUDIT_USER
    MOV CX, 4
    CLD
    REP MOVSB
    CMP AL, 1
    JNE ADMIN_LOGIN_HAS_ID
    JMP ADMIN_LOGIN_EOF
ADMIN_LOGIN_HAS_ID:
    MOV DX, OFFSET MSG_ADMIN_PIN
    CALL PRINT_STRING
    CALL READ_PIN
    MOV ADMIN_PIN_STATUS, AL
    MOV SI, OFFSET ADMIN_ID_BUFFER
    MOV DI, OFFSET PIN_BUFFER
    CALL PIN_HASH
    MOV BP, AX
    CMP ADMIN_PIN_STATUS, 0
    JNE ADMIN_LOGIN_FAILED
    CMP ADMIN_ID_STATUS, 0
    JNE ADMIN_LOGIN_FAILED
    PUSH ES
    PUSH DS
    POP ES
    CLD
    MOV SI, OFFSET ADMIN_ID_BUFFER
    MOV DI, OFFSET DATA_IMAGE+DATA_ADMIN_OFFSET
    MOV CX, 4
    REPE CMPSB
    POP ES
    JNE ADMIN_LOGIN_FAILED
    MOV AX, WORD PTR DATA_IMAGE+DATA_ADMIN_OFFSET+4
    CMP BP, AX
    JE ADMIN_LOGIN_ACCEPTED
ADMIN_LOGIN_FAILED:
    CALL ADMIN_CLEAR_PIN
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_FAILED
    MOV AUDIT_DETAIL_PTR, OFFSET AUDIT_DETAIL_NONE
    CALL AUDIT_WRITE
    INC ADMIN_ATTEMPTS
    CMP ADMIN_ATTEMPTS, 3
    JAE ADMIN_LOGIN_LOCKED
    MOV DX, OFFSET MSG_LOGIN_FAILED
    CALL PRINT_STRING
    JMP ADMIN_LOGIN_ATTEMPT
ADMIN_LOGIN_ACCEPTED:
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_LOGIN
    MOV AUDIT_DETAIL_PTR, OFFSET AUDIT_DETAIL_NONE
    CALL AUDIT_WRITE
    MOV DX, OFFSET MSG_LOGIN_OK
    CALL PRINT_STRING
    XOR AL, AL
    JMP ADMIN_LOGIN_RETURN
ADMIN_LOGIN_LOCKED:
    MOV DX, OFFSET MSG_CONSOLE_LOCKED
    CALL PRINT_STRING
    MOV AL, 2
    JMP ADMIN_LOGIN_RETURN
ADMIN_LOGIN_EOF:
    CALL ADMIN_CLEAR_PIN
    MOV AL, 1
ADMIN_LOGIN_RETURN:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_LOGIN ENDP

; Purpose: Read a four-digit ID, retaining a neutral placeholder if invalid.
; Inputs: DX points to the prompt string.
; Outputs: AL=0 valid, AL=1 EOF, AL=2 malformed; ADMIN_ID_BUFFER holds four bytes.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: LOOP, REP MOVSB, and register-indirect addressing.
ADMIN_READ_ID PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV ADMIN_ID_BUFFER, '-'
    MOV ADMIN_ID_BUFFER+1, '-'
    MOV ADMIN_ID_BUFFER+2, '-'
    MOV ADMIN_ID_BUFFER+3, '-'
    CALL PRINT_STRING
    CALL READ_LINE
    CMP AL, 0
    JE ADMIN_READ_ID_LINE_OK
    CMP AL, 1
    JE ADMIN_READ_ID_EOF
    JMP ADMIN_READ_ID_BAD
ADMIN_READ_ID_LINE_OK:
    CMP LINE_COUNT, 4
    JE ADMIN_READ_ID_CHECK
    JMP ADMIN_READ_ID_BAD
ADMIN_READ_ID_CHECK:
    MOV SI, OFFSET LINE_BUFFER+2
    MOV CX, 4
ADMIN_READ_ID_DIGIT:
    MOV AL, [SI]
    CMP AL, '0'
    JB ADMIN_READ_ID_BAD
    CMP AL, '9'
    JA ADMIN_READ_ID_BAD
    INC SI
    LOOP ADMIN_READ_ID_DIGIT
    MOV SI, OFFSET LINE_BUFFER+2
    MOV DI, OFFSET ADMIN_ID_BUFFER
    MOV CX, 4
    CLD
    REP MOVSB
    XOR AL, AL
    JMP ADMIN_READ_ID_RETURN
ADMIN_READ_ID_EOF:
    MOV AL, 1
    JMP ADMIN_READ_ID_RETURN
ADMIN_READ_ID_BAD:
    MOV AL, 2
ADMIN_READ_ID_RETURN:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_READ_ID ENDP

; Purpose: Clear the shared four-byte PIN input buffer.
; Inputs: None.
; Outputs: PIN_BUFFER contains four zero bytes.
; Registers: Preserves all general and segment registers.
; Flags: Unspecified.
; ISA: REP STOSB and DS-to-ES segment setup.
ADMIN_CLEAR_PIN PROC NEAR
    PUSH AX
    PUSH CX
    PUSH DI
    PUSH ES
    PUSH DS
    POP ES
    CLD
    MOV DI, OFFSET PIN_BUFFER
    MOV CX, 4
    XOR AL, AL
    REP STOSB
    POP ES
    POP DI
    POP CX
    POP AX
    RET
ADMIN_CLEAR_PIN ENDP

; Purpose: Print the required menu and dispatch the account operations.
; Inputs: None.
; Outputs: AL=0 on exit or EOF; AL=4 when the idle timer expires.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES.
; Flags: Unspecified.
; ISA: Direct addressing, conditional branches, and near CALL/RET.
ADMIN_MENU PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
ADMIN_MENU_LOOP:
    MOV DX, OFFSET MSG_MENU
    CALL PRINT_STRING
    CALL ADMIN_READ_MENU
    CMP AL, 4
    JNE ADMIN_MENU_NOT_TIMEOUT
    JMP ADMIN_MENU_TIMEOUT
ADMIN_MENU_NOT_TIMEOUT:
    CMP AL, 1
    JNE ADMIN_MENU_HAS_INPUT
    JMP ADMIN_MENU_DONE
ADMIN_MENU_HAS_INPUT:
    CMP AL, 0
    JNE ADMIN_MENU_INVALID
    CMP LINE_COUNT, 1
    JNE ADMIN_MENU_INVALID
    MOV AL, LINE_BUFFER+2
    CMP AL, '1'
    JE ADMIN_MENU_LIST
    CMP AL, '2'
    JE ADMIN_MENU_VIEW
    CMP AL, '3'
    JE ADMIN_MENU_CREATE
    CMP AL, '4'
    JE ADMIN_MENU_LOCK
    CMP AL, '5'
    JE ADMIN_MENU_RESET_PIN
    CMP AL, '6'
    JE ADMIN_MENU_ADJUST
    CMP AL, '7'
    JE ADMIN_MENU_REPORT
    CMP AL, '8'
    JE ADMIN_MENU_AUDIT
    CMP AL, '9'
    JE ADMIN_MENU_EXIT
ADMIN_MENU_LIST:
    CALL ADMIN_LIST
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_VIEW:
    CALL ADMIN_VIEW
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_CREATE:
    CALL ADMIN_CREATE
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_LOCK:
    CALL ADMIN_LOCK
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_RESET_PIN:
    CALL ADMIN_RESET_PIN
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_ADJUST:
    CALL ADMIN_ADJUST
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_REPORT:
    CALL ADMIN_REPORT
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_AUDIT:
    MOV DX, OFFSET MSG_AUDIT_HELP
    CALL PRINT_STRING
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_EXIT:
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_EXIT
    MOV AUDIT_DETAIL_PTR, OFFSET AUDIT_DETAIL_NONE
    MOV BYTE PTR AUDIT_ACCOUNT, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+1, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+2, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+3, '-'
    CALL AUDIT_WRITE
    JMP ADMIN_MENU_DONE
ADMIN_MENU_INVALID:
    MOV DX, OFFSET MSG_INVALID_CHOICE
    CALL PRINT_STRING
    JMP ADMIN_MENU_LOOP
ADMIN_MENU_TIMEOUT:
    MOV AL, 4
    JMP ADMIN_MENU_RETURN
ADMIN_MENU_DONE:
    XOR AL, AL
ADMIN_MENU_RETURN:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_MENU ENDP

; Purpose: Read menu input with an idle-timeout poll on interactive stdin.
; Inputs: SWITCH_KIND identifies /T; stdin is checked with DOS IOCTL.
; Outputs: AL=0 line ready, AL=1 EOF, AL=2 invalid/long line, AL=4 timeout.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: INT 21h/AH=0Bh and AH=08h, based addressing, and CS override.
ADMIN_READ_MENU PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    CMP SWITCH_KIND, 'T'
    JNE ADMIN_READ_MENU_NOT_TEST
    JMP ADMIN_READ_MENU_BUFFERED
ADMIN_READ_MENU_NOT_TEST:
    MOV AX, 4400h
    XOR BX, BX
    INT 21h
    JNC ADMIN_READ_MENU_IOCTL_OK
    JMP ADMIN_READ_MENU_BUFFERED
ADMIN_READ_MENU_IOCTL_OK:
    TEST DL, 80h
    JNZ ADMIN_READ_MENU_CONSOLE
    JMP ADMIN_READ_MENU_BUFFERED

ADMIN_READ_MENU_CONSOLE:
    MOV LINE_COUNT, 0
    MOV LINE_TOO_LONG, 0
    MOV LINE_BUFFER+1, 0
    MOV LINE_BUFFER+2, '$'
    MOV CS:ISR_TICKS, 0
ADMIN_READ_MENU_POLL:
    MOV AH, 0Bh
    INT 21h
    OR AL, AL
    JNZ ADMIN_READ_MENU_KEY
    MOV AX, CS:ISR_TICKS
    CMP AX, ISR_TIMEOUT_TICKS
    JAE ADMIN_READ_MENU_TIMEOUT
    JMP ADMIN_READ_MENU_POLL
ADMIN_READ_MENU_KEY:
    MOV AH, 08h
    INT 21h
    MOV CS:ISR_TICKS, 0
    CMP AL, 0Dh
    JE ADMIN_READ_MENU_TERMINATE
    CMP AL, 08h
    JNE ADMIN_READ_MENU_STORE
    CMP LINE_COUNT, 0
    JE ADMIN_READ_MENU_POLL
    DEC LINE_COUNT
    MOV BX, LINE_COUNT
    MOV BYTE PTR LINE_BUFFER[BX+2], '$'
    MOV DL, 08h
    CALL PRINT_CHAR
    MOV DL, ' '
    CALL PRINT_CHAR
    MOV DL, 08h
    CALL PRINT_CHAR
    JMP ADMIN_READ_MENU_POLL
ADMIN_READ_MENU_STORE:
    MOV BX, LINE_COUNT
    CMP BX, 79
    JB ADMIN_READ_MENU_STORE_CHAR
    MOV LINE_TOO_LONG, 1
    JMP ADMIN_READ_MENU_ECHO
ADMIN_READ_MENU_STORE_CHAR:
    MOV LINE_BUFFER[BX+2], AL
    INC LINE_COUNT
ADMIN_READ_MENU_ECHO:
    MOV DL, AL
    CALL PRINT_CHAR
    JMP ADMIN_READ_MENU_POLL
ADMIN_READ_MENU_TERMINATE:
    CALL PRINT_NEWLINE
    MOV BX, LINE_COUNT
    MOV BYTE PTR LINE_BUFFER[BX+2], '$'
    MOV AL, BL
    MOV LINE_BUFFER+1, AL
    CMP LINE_TOO_LONG, 0
    JNE ADMIN_READ_MENU_BAD
    XOR AL, AL
    JMP ADMIN_READ_MENU_RETURN
ADMIN_READ_MENU_BUFFERED:
    CALL READ_LINE
    JMP ADMIN_READ_MENU_RETURN
ADMIN_READ_MENU_BAD:
    MOV AL, 2
    JMP ADMIN_READ_MENU_RETURN
ADMIN_READ_MENU_TIMEOUT:
    MOV AL, 4
ADMIN_READ_MENU_RETURN:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_READ_MENU ENDP

; Purpose: Append the timeout event and save the current account image.
; Inputs: The authenticated admin ID and current account image are available.
; Outputs: Writes the timeout event and attempts a data save.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: Near CALL/RET and conditional branches.
ADMIN_TIMEOUT PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_TIMEOUT
    MOV AUDIT_DETAIL_PTR, OFFSET AUDIT_DETAIL_NONE
    MOV BYTE PTR AUDIT_ACCOUNT, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+1, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+2, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+3, '-'
    CALL AUDIT_WRITE
    CALL DATA_SAVE
    CMP AL, 0
    JE ADMIN_TIMEOUT_DONE
    MOV DX, OFFSET MSG_DATA_SAVE_FAILED
    CALL PRINT_STRING
ADMIN_TIMEOUT_DONE:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_TIMEOUT ENDP

; Purpose: Print the account table with formatted packed-BCD balances.
; Inputs: DATA_IMAGE contains the validated customer count and records.
; Outputs: Writes the table header and every account record.
; Registers: Preserves all general and segment registers.
; Flags: Unspecified.
; ISA: LOOP and based-indexed record addressing.
ADMIN_LIST PROC NEAR
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    MOV DX, OFFSET MSG_ACCOUNT_HEADER
    CALL PRINT_STRING
    XOR CX, CX
    MOV CL, DATA_IMAGE+5
    MOV SI, OFFSET DATA_IMAGE+DATA_ACCOUNT_OFFSET
    OR CX, CX
    JZ ADMIN_LIST_DONE
ADMIN_LIST_NEXT:
    CALL ADMIN_PRINT_RECORD
    ADD SI, DATA_RECORD_SIZE
    LOOP ADMIN_LIST_NEXT
ADMIN_LIST_DONE:
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
ADMIN_LIST ENDP

; Purpose: Look up ADMIN_ID_BUFFER among the customer account IDs.
; Inputs: ADMIN_ID_BUFFER contains four ASCII digits.
; Outputs: AX is the record offset, or zero if no record matches.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES.
; Flags: Unspecified.
; ISA: REPE CMPSB and register-indirect addressing.
ADMIN_LOOKUP PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    PUSH ES
    XOR AX, AX
    XOR BX, BX
    MOV BL, DATA_IMAGE+5
    MOV ADMIN_SEARCH_COUNT, BX
    MOV DI, OFFSET DATA_IMAGE+DATA_ACCOUNT_OFFSET
    PUSH DS
    POP ES
    CLD
ADMIN_LOOKUP_NEXT:
    CMP ADMIN_SEARCH_COUNT, 0
    JE ADMIN_LOOKUP_MISSING
    MOV SI, OFFSET ADMIN_ID_BUFFER
    MOV CX, 4
    REPE CMPSB
    JE ADMIN_LOOKUP_FOUND
    ADD DI, 12
    DEC ADMIN_SEARCH_COUNT
    JMP ADMIN_LOOKUP_NEXT
ADMIN_LOOKUP_FOUND:
    MOV AX, DI
    SUB AX, 4
    JMP ADMIN_LOOKUP_RETURN
ADMIN_LOOKUP_MISSING:
    XOR AX, AX
ADMIN_LOOKUP_RETURN:
    POP ES
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_LOOKUP ENDP

; Purpose: Print one account's ID, status, and formatted balance.
; Inputs: SI points to the start of a 16-byte customer record.
; Outputs: Writes one account row followed by CR/LF.
; Registers: Preserves all general and segment registers.
; Flags: Unspecified.
; ISA: LOOP and based addressing.
ADMIN_PRINT_RECORD PROC NEAR
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    MOV BX, SI
    MOV CX, 4
ADMIN_PRINT_ID:
    MOV DL, [SI]
    CALL PRINT_CHAR
    INC SI
    LOOP ADMIN_PRINT_ID
    MOV DX, OFFSET ADMIN_TWO_SPACES
    CALL PRINT_STRING
    CMP BYTE PTR [BX+12], 1
    JNE ADMIN_PRINT_LOCKED
    MOV DX, OFFSET ADMIN_STATUS_ACTIVE
    CALL PRINT_STRING
    JMP ADMIN_PRINT_BALANCE
ADMIN_PRINT_LOCKED:
    MOV DX, OFFSET ADMIN_STATUS_LOCKED
    CALL PRINT_STRING
ADMIN_PRINT_BALANCE:
    MOV DX, OFFSET ADMIN_TWO_SPACES
    CALL PRINT_STRING
    MOV SI, BX
    ADD SI, 6
    MOV DI, OFFSET ADMIN_FORMAT
    CALL bcd_format
    MOV DX, OFFSET ADMIN_FORMAT
    CALL PRINT_STRING
    CALL PRINT_NEWLINE
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
ADMIN_PRINT_RECORD ENDP

; Purpose: Prompt for and display one customer account.
; Inputs: Validated DATA_IMAGE.
; Outputs: Prints the row or "Account not found".
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES.
; Flags: Unspecified.
; ISA: Near CALL/RET, CMP, and conditional branches.
ADMIN_VIEW PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV DX, OFFSET MSG_ACCOUNT_PROMPT
    CALL ADMIN_READ_ID
    CMP AL, 1
    JE ADMIN_VIEW_DONE
    CMP AL, 0
    JNE ADMIN_VIEW_MISSING
    CALL ADMIN_LOOKUP
    OR AX, AX
    JZ ADMIN_VIEW_MISSING
    MOV SI, AX
    CALL ADMIN_PRINT_RECORD
    JMP ADMIN_VIEW_DONE
ADMIN_VIEW_MISSING:
    MOV DX, OFFSET MSG_ACCOUNT_MISSING
    CALL PRINT_STRING
ADMIN_VIEW_DONE:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_VIEW ENDP

; Purpose: Validate and persist a new customer account and opening balance.
; Inputs: DATA_IMAGE contains the current account table.
; Outputs: Adds one record on success; reports validation or save errors.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES.
; Flags: Unspecified.
; ISA: REP MOVSB/STOSB, SHL by CL, and based addressing.
ADMIN_CREATE PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV DX, OFFSET MSG_ACCOUNT_PROMPT
    CALL ADMIN_READ_ID
    CMP AL, 1
    JNE ADMIN_CREATE_ID_NOT_EOF
    JMP ADMIN_CREATE_DONE
ADMIN_CREATE_ID_NOT_EOF:
    CMP AL, 0
    JE ADMIN_CREATE_ID_VALID
    JMP ADMIN_CREATE_BAD_ID
ADMIN_CREATE_ID_VALID:
    CALL ADMIN_LOOKUP
    OR AX, AX
    JZ ADMIN_CREATE_NOT_DUPLICATE
    JMP ADMIN_CREATE_EXISTS
ADMIN_CREATE_NOT_DUPLICATE:
    MOV AL, DATA_IMAGE+5
    CMP AL, DATA_MAX_ACCOUNTS
    JB ADMIN_CREATE_HAS_SPACE
    JMP ADMIN_CREATE_FULL
ADMIN_CREATE_HAS_SPACE:
    MOV DX, OFFSET MSG_CUSTOMER_PIN
    CALL PRINT_STRING
    CALL READ_PIN
    CMP AL, 0
    JE ADMIN_CREATE_PIN_VALID
    JMP ADMIN_CREATE_BAD_PIN
ADMIN_CREATE_PIN_VALID:
    MOV DX, OFFSET MSG_OPENING_BALANCE
    CALL PRINT_STRING
    CALL READ_LINE
    CMP AL, 0
    JE ADMIN_CREATE_AMOUNT_LINE_OK
    JMP ADMIN_CREATE_BAD_AMOUNT
ADMIN_CREATE_AMOUNT_LINE_OK:
    MOV SI, OFFSET LINE_BUFFER+2
    MOV CX, LINE_COUNT
    MOV DI, OFFSET ADMIN_AMOUNT
    CALL bcd_parse
    CMP AL, 0
    JE ADMIN_CREATE_AMOUNT_PARSED
    JMP ADMIN_CREATE_BAD_AMOUNT
ADMIN_CREATE_AMOUNT_PARSED:
    MOV SI, OFFSET ADMIN_AMOUNT
    MOV DI, OFFSET ADMIN_AMOUNT_LIMIT
    CALL bcd_cmp
    JC ADMIN_CREATE_AMOUNT_OK
    JZ ADMIN_CREATE_AMOUNT_OK
    JMP ADMIN_CREATE_BAD_AMOUNT
ADMIN_CREATE_AMOUNT_OK:
    MOV AL, DATA_IMAGE+5
    XOR AH, AH
    MOV CL, 4
    SHL AX, CL
    MOV DI, OFFSET DATA_IMAGE+DATA_ACCOUNT_OFFSET
    ADD DI, AX
    MOV ADMIN_RECORD_PTR, DI
    MOV CX, DATA_RECORD_SIZE
    PUSH ES
    PUSH DS
    POP ES
    CLD
    XOR AL, AL
    REP STOSB
    MOV DI, ADMIN_RECORD_PTR
    MOV SI, OFFSET ADMIN_ID_BUFFER
    MOV CX, 4
    REP MOVSB
    MOV SI, ADMIN_RECORD_PTR
    MOV DI, OFFSET PIN_BUFFER
    CALL PIN_HASH
    MOV BX, ADMIN_RECORD_PTR
    MOV WORD PTR [BX+4], AX
    MOV SI, OFFSET ADMIN_AMOUNT
    MOV DI, BX
    ADD DI, 6
    MOV CX, 6
    REP MOVSB
    MOV BYTE PTR [BX+12], 1
    INC BYTE PTR DATA_IMAGE+5
    CALL DATA_SAVE
    POP ES
    CMP AL, 0
    JE ADMIN_CREATE_SAVE_OK
    JMP ADMIN_CREATE_SAVE_ERROR
ADMIN_CREATE_SAVE_OK:
    MOV SI, OFFSET ADMIN_ID_BUFFER
    CALL ADMIN_SET_AUDIT_ACCOUNT
    MOV SI, OFFSET ADMIN_AMOUNT
    MOV DI, OFFSET ADMIN_FORMAT
    CALL bcd_format
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_CREATE
    MOV AUDIT_DETAIL_PTR, OFFSET ADMIN_FORMAT
    CALL AUDIT_WRITE
    MOV DX, OFFSET MSG_ACCOUNT_CREATED
    CALL PRINT_STRING
    JMP ADMIN_CREATE_DONE
ADMIN_CREATE_BAD_ID:
    MOV DX, OFFSET MSG_ACCOUNT_INVALID
    CALL PRINT_STRING
    JMP ADMIN_CREATE_DONE
ADMIN_CREATE_EXISTS:
    MOV DX, OFFSET MSG_ACCOUNT_EXISTS
    CALL PRINT_STRING
    JMP ADMIN_CREATE_DONE
ADMIN_CREATE_FULL:
    MOV DX, OFFSET MSG_TABLE_FULL
    CALL PRINT_STRING
    JMP ADMIN_CREATE_DONE
ADMIN_CREATE_BAD_PIN:
    CALL ADMIN_CLEAR_PIN
    MOV DX, OFFSET MSG_PIN_INVALID
    CALL PRINT_STRING
    JMP ADMIN_CREATE_DONE
ADMIN_CREATE_BAD_AMOUNT:
    CALL ADMIN_CLEAR_PIN
    MOV DX, OFFSET MSG_AMOUNT_INVALID
    CALL PRINT_STRING
    JMP ADMIN_CREATE_DONE
ADMIN_CREATE_SAVE_ERROR:
    DEC BYTE PTR DATA_IMAGE+5
    MOV BX, ADMIN_RECORD_PTR
    MOV CX, DATA_RECORD_SIZE
    XOR AL, AL
    MOV DI, BX
    CLD
    REP STOSB
    MOV DX, OFFSET MSG_DATA_SAVE_FAILED
    CALL PRINT_STRING
ADMIN_CREATE_DONE:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_CREATE ENDP

; Purpose: Copy a four-byte account ID into the audit record field.
; Inputs: DS:SI points to four ASCII account digits.
; Outputs: AUDIT_ACCOUNT contains the digits followed by '$'.
; Registers: Preserves all general and segment registers.
; Flags: Unspecified.
; ISA: REP MOVSB and segment override-free register-indirect addressing.
ADMIN_SET_AUDIT_ACCOUNT PROC NEAR
    PUSH AX
    PUSH CX
    PUSH DI
    PUSH SI
    PUSH ES
    PUSH DS
    POP ES
    CLD
    MOV DI, OFFSET AUDIT_ACCOUNT
    MOV CX, 4
    REP MOVSB
    MOV BYTE PTR [DI], '$'
    POP ES
    POP SI
    POP DI
    POP CX
    POP AX
    RET
ADMIN_SET_AUDIT_ACCOUNT ENDP

; Purpose: Toggle an account's lock state and persist the changed record.
; Inputs: The account number is read from standard input.
; Outputs: Saves and audits LOCK or UNLOCK, or reports a lookup/save error.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: MOV, CMP, conditional branches, and based addressing.
ADMIN_LOCK PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV DX, OFFSET MSG_ACCOUNT_PROMPT
    CALL ADMIN_READ_ID
    CMP AL, 1
    JNE ADMIN_LOCK_ID_READY
    JMP ADMIN_LOCK_DONE
ADMIN_LOCK_ID_READY:
    CMP AL, 0
    JE ADMIN_LOCK_LOOKUP
    JMP ADMIN_LOCK_MISSING
ADMIN_LOCK_LOOKUP:
    CALL ADMIN_LOOKUP
    OR AX, AX
    JNZ ADMIN_LOCK_FOUND
    JMP ADMIN_LOCK_MISSING
ADMIN_LOCK_FOUND:
    MOV ADMIN_RECORD_PTR, AX
    MOV BX, AX
    MOV AL, [BX+12]
    MOV ADMIN_OLD_STATUS, AL
    OR AL, AL
    JZ ADMIN_LOCK_UNLOCK
    MOV BYTE PTR [BX+12], 0
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_LOCK
    JMP ADMIN_LOCK_SAVE
ADMIN_LOCK_UNLOCK:
    MOV BYTE PTR [BX+12], 1
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_UNLOCK
ADMIN_LOCK_SAVE:
    CALL DATA_SAVE
    OR AL, AL
    JZ ADMIN_LOCK_SAVED
    MOV BX, ADMIN_RECORD_PTR
    MOV AL, ADMIN_OLD_STATUS
    MOV [BX+12], AL
    MOV DX, OFFSET MSG_DATA_SAVE_FAILED
    CALL PRINT_STRING
    JMP ADMIN_LOCK_DONE
ADMIN_LOCK_SAVED:
    MOV BX, ADMIN_RECORD_PTR
    MOV SI, BX
    CALL ADMIN_SET_AUDIT_ACCOUNT
    MOV AUDIT_DETAIL_PTR, OFFSET AUDIT_DETAIL_NONE
    CALL AUDIT_WRITE
    CMP BYTE PTR [BX+12], 1
    JE ADMIN_LOCK_PRINT_UNLOCKED
    MOV DX, OFFSET MSG_ACCOUNT_LOCKED
    CALL PRINT_STRING
    JMP ADMIN_LOCK_DONE
ADMIN_LOCK_PRINT_UNLOCKED:
    MOV DX, OFFSET MSG_ACCOUNT_UNLOCKED
    CALL PRINT_STRING
    JMP ADMIN_LOCK_DONE
ADMIN_LOCK_MISSING:
    MOV DX, OFFSET MSG_ACCOUNT_MISSING
    CALL PRINT_STRING
ADMIN_LOCK_DONE:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_LOCK ENDP

; Purpose: Replace one customer's PIN hash and persist the updated record.
; Inputs: Account number and masked four-digit PIN are read from input.
; Outputs: Saves and audits RESETPIN or reports validation/save errors.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: MOV, REP STOSB via ADMIN_CLEAR_PIN, and based addressing.
ADMIN_RESET_PIN PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV DX, OFFSET MSG_ACCOUNT_PROMPT
    CALL ADMIN_READ_ID
    CMP AL, 1
    JNE ADMIN_RESET_ID_READY
    JMP ADMIN_RESET_DONE
ADMIN_RESET_ID_READY:
    CMP AL, 0
    JE ADMIN_RESET_LOOKUP
    JMP ADMIN_RESET_MISSING
ADMIN_RESET_LOOKUP:
    CALL ADMIN_LOOKUP
    OR AX, AX
    JNZ ADMIN_RESET_FOUND
    JMP ADMIN_RESET_MISSING
ADMIN_RESET_FOUND:
    MOV ADMIN_RECORD_PTR, AX
    MOV DX, OFFSET MSG_CUSTOMER_PIN
    CALL PRINT_STRING
    CALL READ_PIN
    OR AL, AL
    JZ ADMIN_RESET_PIN_READY
    CALL ADMIN_CLEAR_PIN
    MOV DX, OFFSET MSG_PIN_INVALID
    CALL PRINT_STRING
    JMP ADMIN_RESET_DONE
ADMIN_RESET_PIN_READY:
    MOV BX, ADMIN_RECORD_PTR
    MOV AX, WORD PTR [BX+4]
    MOV ADMIN_OLD_HASH, AX
    MOV SI, BX
    MOV DI, OFFSET PIN_BUFFER
    CALL PIN_HASH
    MOV BX, ADMIN_RECORD_PTR
    MOV WORD PTR [BX+4], AX
    CALL DATA_SAVE
    OR AL, AL
    JZ ADMIN_RESET_SAVED
    MOV BX, ADMIN_RECORD_PTR
    MOV AX, ADMIN_OLD_HASH
    MOV WORD PTR [BX+4], AX
    MOV DX, OFFSET MSG_DATA_SAVE_FAILED
    CALL PRINT_STRING
    JMP ADMIN_RESET_DONE
ADMIN_RESET_SAVED:
    MOV BX, ADMIN_RECORD_PTR
    MOV SI, BX
    CALL ADMIN_SET_AUDIT_ACCOUNT
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_RESETPIN
    MOV AUDIT_DETAIL_PTR, OFFSET AUDIT_DETAIL_NONE
    CALL AUDIT_WRITE
    MOV DX, OFFSET MSG_PIN_RESET
    CALL PRINT_STRING
    JMP ADMIN_RESET_DONE
ADMIN_RESET_MISSING:
    MOV DX, OFFSET MSG_ACCOUNT_MISSING
    CALL PRINT_STRING
ADMIN_RESET_DONE:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_RESET_PIN ENDP

; Purpose: Apply a bounded, nonzero credit or debit to one account.
; Inputs: Account, operation, and amount are read from standard input.
; Outputs: Persists and audits a valid adjustment; rejected changes are undone.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: ADC/DAA and SBB/DAS via BCD procedures, REP MOVSB, and based addressing.
ADMIN_ADJUST PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV DX, OFFSET MSG_ACCOUNT_PROMPT
    CALL ADMIN_READ_ID
    CMP AL, 1
    JNE ADMIN_ADJUST_ID_READY
    JMP ADMIN_ADJUST_DONE
ADMIN_ADJUST_ID_READY:
    CMP AL, 0
    JE ADMIN_ADJUST_LOOKUP
    JMP ADMIN_ADJUST_MISSING
ADMIN_ADJUST_LOOKUP:
    CALL ADMIN_LOOKUP
    OR AX, AX
    JNZ ADMIN_ADJUST_FOUND
    JMP ADMIN_ADJUST_MISSING
ADMIN_ADJUST_FOUND:
    MOV ADMIN_RECORD_PTR, AX
    MOV DX, OFFSET MSG_ADJUST_KIND
    CALL PRINT_STRING
    CALL READ_LINE
    OR AL, AL
    JZ ADMIN_ADJUST_KIND_LINE
    JMP ADMIN_ADJUST_BAD_AMOUNT
ADMIN_ADJUST_KIND_LINE:
    CMP LINE_COUNT, 1
    JE ADMIN_ADJUST_KIND_LENGTH_OK
    JMP ADMIN_ADJUST_BAD_AMOUNT
ADMIN_ADJUST_KIND_LENGTH_OK:
    MOV AL, LINE_BUFFER+2
    CMP AL, 'c'
    JNE ADMIN_ADJUST_NOT_LOWER_C
    MOV AL, 'C'
ADMIN_ADJUST_NOT_LOWER_C:
    CMP AL, 'd'
    JNE ADMIN_ADJUST_NOT_LOWER_D
    MOV AL, 'D'
ADMIN_ADJUST_NOT_LOWER_D:
    CMP AL, 'C'
    JE ADMIN_ADJUST_CREDIT_KIND
    CMP AL, 'D'
    JE ADMIN_ADJUST_DEBIT_KIND
    JMP ADMIN_ADJUST_BAD_AMOUNT
ADMIN_ADJUST_CREDIT_KIND:
    MOV ADMIN_ADJUST_KIND, 'C'
    JMP ADMIN_ADJUST_READ_AMOUNT
ADMIN_ADJUST_DEBIT_KIND:
    MOV ADMIN_ADJUST_KIND, 'D'
ADMIN_ADJUST_READ_AMOUNT:
    MOV DX, OFFSET MSG_AMOUNT_PROMPT
    CALL PRINT_STRING
    CALL READ_LINE
    OR AL, AL
    JZ ADMIN_ADJUST_PARSE
    JMP ADMIN_ADJUST_BAD_AMOUNT
ADMIN_ADJUST_PARSE:
    MOV SI, OFFSET LINE_BUFFER+2
    MOV CX, LINE_COUNT
    MOV DI, OFFSET ADMIN_AMOUNT
    CALL bcd_parse
    OR AL, AL
    JZ ADMIN_ADJUST_AMOUNT_PARSED
    JMP ADMIN_ADJUST_BAD_AMOUNT
ADMIN_ADJUST_AMOUNT_PARSED:
    MOV SI, OFFSET ADMIN_AMOUNT
    MOV DI, OFFSET ADMIN_ZERO
    CALL bcd_cmp
    JNZ ADMIN_ADJUST_NONZERO
    JMP ADMIN_ADJUST_BAD_AMOUNT
ADMIN_ADJUST_NONZERO:
    MOV SI, OFFSET ADMIN_AMOUNT
    MOV DI, OFFSET ADMIN_AMOUNT_LIMIT
    CALL bcd_cmp
    JC ADMIN_ADJUST_AMOUNT_LIMIT_OK
    JZ ADMIN_ADJUST_AMOUNT_LIMIT_OK
    JMP ADMIN_ADJUST_BAD_AMOUNT
ADMIN_ADJUST_AMOUNT_LIMIT_OK:
    MOV BX, ADMIN_RECORD_PTR
    MOV SI, BX
    ADD SI, 6
    MOV DI, OFFSET ADMIN_OLD_BALANCE
    MOV CX, 6
    PUSH ES
    PUSH DS
    POP ES
    CLD
    REP MOVSB
    POP ES
    MOV BX, ADMIN_RECORD_PTR
    MOV SI, OFFSET ADMIN_AMOUNT
    MOV DI, BX
    ADD DI, 6
    CMP ADMIN_ADJUST_KIND, 'C'
    JNE ADMIN_ADJUST_SUBTRACT
    CALL bcd_add
    JNC ADMIN_ADJUST_ARITHMETIC_OK
    JMP ADMIN_ADJUST_OVERFLOW
ADMIN_ADJUST_SUBTRACT:
    CALL bcd_sub
    JNC ADMIN_ADJUST_ARITHMETIC_OK
    JMP ADMIN_ADJUST_INSUFFICIENT
ADMIN_ADJUST_ARITHMETIC_OK:
    CALL DATA_SAVE
    OR AL, AL
    JZ ADMIN_ADJUST_SAVED
    JMP ADMIN_ADJUST_SAVE_ERROR
ADMIN_ADJUST_SAVED:
    MOV SI, OFFSET ADMIN_AMOUNT
    MOV DI, OFFSET ADMIN_FORMAT
    CALL bcd_format
    MOV BX, ADMIN_RECORD_PTR
    MOV SI, BX
    CALL ADMIN_SET_AUDIT_ACCOUNT
    MOV AUDIT_DETAIL_PTR, OFFSET ADMIN_FORMAT
    CMP ADMIN_ADJUST_KIND, 'C'
    JNE ADMIN_ADJUST_AUDIT_DEBIT
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_CREDIT
    JMP ADMIN_ADJUST_AUDIT
ADMIN_ADJUST_AUDIT_DEBIT:
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_DEBIT
ADMIN_ADJUST_AUDIT:
    CALL AUDIT_WRITE
    MOV DX, OFFSET MSG_BALANCE_ADJUSTED
    CALL PRINT_STRING
    JMP ADMIN_ADJUST_DONE
ADMIN_ADJUST_OVERFLOW:
    MOV BX, ADMIN_RECORD_PTR
    JMP ADMIN_ADJUST_RESTORE_BALANCE
ADMIN_ADJUST_INSUFFICIENT:
    MOV BX, ADMIN_RECORD_PTR
ADMIN_ADJUST_RESTORE_BALANCE:
    MOV SI, OFFSET ADMIN_OLD_BALANCE
    MOV DI, BX
    ADD DI, 6
    MOV CX, 6
    PUSH ES
    PUSH DS
    POP ES
    CLD
    REP MOVSB
    POP ES
    CMP ADMIN_ADJUST_KIND, 'C'
    JNE ADMIN_ADJUST_SHOW_INSUFFICIENT
    MOV DX, OFFSET MSG_BALANCE_OVERFLOW
    CALL PRINT_STRING
    JMP ADMIN_ADJUST_DONE
ADMIN_ADJUST_SHOW_INSUFFICIENT:
    MOV DX, OFFSET MSG_INSUFFICIENT
    CALL PRINT_STRING
    JMP ADMIN_ADJUST_DONE
ADMIN_ADJUST_SAVE_ERROR:
    MOV BX, ADMIN_RECORD_PTR
    JMP ADMIN_ADJUST_RESTORE_SAVE
ADMIN_ADJUST_RESTORE_SAVE:
    MOV SI, OFFSET ADMIN_OLD_BALANCE
    MOV DI, BX
    ADD DI, 6
    MOV CX, 6
    PUSH ES
    PUSH DS
    POP ES
    CLD
    REP MOVSB
    POP ES
    MOV DX, OFFSET MSG_DATA_SAVE_FAILED
    CALL PRINT_STRING
    JMP ADMIN_ADJUST_DONE
ADMIN_ADJUST_BAD_AMOUNT:
    MOV DX, OFFSET MSG_AMOUNT_INVALID
    CALL PRINT_STRING
    JMP ADMIN_ADJUST_DONE
ADMIN_ADJUST_MISSING:
    MOV DX, OFFSET MSG_ACCOUNT_MISSING
    CALL PRINT_STRING
ADMIN_ADJUST_DONE:
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_ADJUST ENDP

; Purpose: Count account states and print the packed-BCD balance total.
; Inputs: DATA_IMAGE contains the validated customer table.
; Outputs: Prints the required account, active, locked, and total lines.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: LOOP, ADC/DAA via bcd_add, and based-indexed record access.
ADMIN_REPORT PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    PUSH ES
    PUSH DS
    POP ES
    CLD
    MOV DI, OFFSET ADMIN_TOTAL
    MOV CX, 7
    XOR AL, AL
    REP STOSB
    MOV ADMIN_ACTIVE_COUNT, 0
    MOV ADMIN_LOCKED_COUNT, 0
    MOV CL, DATA_IMAGE+5
    XOR CH, CH
    MOV SI, OFFSET DATA_IMAGE+DATA_ACCOUNT_OFFSET
    OR CX, CX
    JZ ADMIN_REPORT_PRINT
ADMIN_REPORT_NEXT:
    CMP BYTE PTR [SI+12], 1
    JNE ADMIN_REPORT_COUNT_LOCKED
    INC ADMIN_ACTIVE_COUNT
    JMP ADMIN_REPORT_ADD_BALANCE
ADMIN_REPORT_COUNT_LOCKED:
    INC ADMIN_LOCKED_COUNT
ADMIN_REPORT_ADD_BALANCE:
    MOV DI, OFFSET ADMIN_TOTAL
    MOV BX, SI
    MOV SI, BX
    ADD SI, 6
    CALL bcd_add
    JNC ADMIN_REPORT_SUM_OK
    ADD BYTE PTR ADMIN_TOTAL+6, 1
    DAA
ADMIN_REPORT_SUM_OK:
    MOV SI, BX
    ADD SI, DATA_RECORD_SIZE
    LOOP ADMIN_REPORT_NEXT
ADMIN_REPORT_PRINT:
    MOV DX, OFFSET MSG_REPORT_ACCOUNTS
    CALL PRINT_STRING
    XOR AX, AX
    MOV AL, DATA_IMAGE+5
    CALL PRINT_DECIMAL
    CALL PRINT_NEWLINE
    MOV DX, OFFSET MSG_REPORT_ACTIVE
    CALL PRINT_STRING
    MOV AX, ADMIN_ACTIVE_COUNT
    CALL PRINT_DECIMAL
    CALL PRINT_NEWLINE
    MOV DX, OFFSET MSG_REPORT_LOCKED
    CALL PRINT_STRING
    MOV AX, ADMIN_LOCKED_COUNT
    CALL PRINT_DECIMAL
    CALL PRINT_NEWLINE
    MOV DX, OFFSET MSG_REPORT_TOTAL
    CALL PRINT_STRING
    CALL ADMIN_FORMAT_TOTAL
    MOV DX, OFFSET ADMIN_TOTAL_TEXT
    CALL PRINT_STRING
    CALL PRINT_NEWLINE
    MOV AUDIT_ACTION_PTR, OFFSET AUDIT_ACTION_REPORT
    MOV AUDIT_DETAIL_PTR, OFFSET AUDIT_DETAIL_NONE
    MOV BYTE PTR AUDIT_ACCOUNT, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+1, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+2, '-'
    MOV BYTE PTR AUDIT_ACCOUNT+3, '-'
    CALL AUDIT_WRITE
    POP ES
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
ADMIN_REPORT ENDP

; Purpose: Format the seven-byte packed-BCD report total without leading zeroes.
; Inputs: ADMIN_TOTAL contains seven little-endian packed-BCD bytes.
; Outputs: ADMIN_TOTAL_TEXT receives a '$'-terminated amount with two decimals.
; Registers: Preserves all general registers.
; Flags: Unspecified.
; ISA: SHR by one and register-indirect addressing.
ADMIN_FORMAT_TOTAL PROC NEAR
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV DI, OFFSET ADMIN_TOTAL_TEXT
    MOV SI, OFFSET ADMIN_TOTAL+6
    MOV CX, 6
    XOR BP, BP
ADMIN_FORMAT_TOTAL_BYTE:
    MOV AL, [SI]
    AND AL, 0F0h
    SHR AL, 1
    SHR AL, 1
    SHR AL, 1
    SHR AL, 1
    OR AL, AL
    JNZ ADMIN_FORMAT_TOTAL_HIGH
    OR BP, BP
    JZ ADMIN_FORMAT_TOTAL_LOW
ADMIN_FORMAT_TOTAL_HIGH:
    ADD AL, '0'
    MOV [DI], AL
    INC DI
    MOV BP, 1
ADMIN_FORMAT_TOTAL_LOW:
    MOV AL, [SI]
    AND AL, 0Fh
    OR AL, AL
    JNZ ADMIN_FORMAT_TOTAL_EMIT_LOW
    OR BP, BP
    JZ ADMIN_FORMAT_TOTAL_NEXT
ADMIN_FORMAT_TOTAL_EMIT_LOW:
    ADD AL, '0'
    MOV [DI], AL
    INC DI
    MOV BP, 1
ADMIN_FORMAT_TOTAL_NEXT:
    DEC SI
    LOOP ADMIN_FORMAT_TOTAL_BYTE
    OR BP, BP
    JNZ ADMIN_FORMAT_TOTAL_POINT
    MOV BYTE PTR [DI], '0'
    INC DI
ADMIN_FORMAT_TOTAL_POINT:
    MOV BYTE PTR [DI], '.'
    INC DI
    MOV AL, [ADMIN_TOTAL]
    AND AL, 0F0h
    SHR AL, 1
    SHR AL, 1
    SHR AL, 1
    SHR AL, 1
    ADD AL, '0'
    MOV [DI], AL
    INC DI
    MOV AL, [ADMIN_TOTAL]
    AND AL, 0Fh
    ADD AL, '0'
    MOV [DI], AL
    INC DI
    MOV BYTE PTR [DI], '$'
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
ADMIN_FORMAT_TOTAL ENDP

; Purpose: Append one timestamped administrator event to AUDIT.LOG.
; Inputs: AUDIT_USER, AUDIT_ACTION_PTR, AUDIT_ACCOUNT, and AUDIT_DETAIL_PTR.
; Outputs: Appends the event; AL=0 on success or 1 with an explicit error message.
; Registers: Preserves BX, CX, DX, SI, DI, BP, DS, and ES.
; Flags: Unspecified.
; ISA: INT, MOV, REP MOVSB, register-indirect strings, and direct addressing.
AUDIT_WRITE PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    PUSH ES
    MOV AUDIT_STATUS, 1
    CMP SWITCH_KIND, 'T'
    JNE AUDIT_WRITE_CLOCK
    MOV AUDIT_YEAR, 2000
    MOV AUDIT_MONTH, 1
    MOV AUDIT_DAY, 1
    MOV AUDIT_HOUR, 0
    MOV AUDIT_MINUTE, 0
    MOV AUDIT_SECOND, 0
    JMP AUDIT_WRITE_BUILD
AUDIT_WRITE_CLOCK:
    MOV AH, 2Ah
    INT 21h
    MOV AUDIT_YEAR, CX
    MOV AUDIT_MONTH, DH
    MOV AUDIT_DAY, DL
    MOV AH, 2Ch
    INT 21h
    MOV AUDIT_HOUR, CH
    MOV AUDIT_MINUTE, CL
    MOV AUDIT_SECOND, DH
AUDIT_WRITE_BUILD:
    PUSH DS
    POP ES
    CLD
    MOV DI, OFFSET AUDIT_LINE
    MOV AX, AUDIT_YEAR
    CALL AUDIT_WRITE_YEAR
    MOV BYTE PTR [DI], '-'
    INC DI
    MOV AL, AUDIT_MONTH
    CALL AUDIT_WRITE_TWO
    MOV BYTE PTR [DI], '-'
    INC DI
    MOV AL, AUDIT_DAY
    CALL AUDIT_WRITE_TWO
    MOV BYTE PTR [DI], ' '
    INC DI
    MOV AL, AUDIT_HOUR
    CALL AUDIT_WRITE_TWO
    MOV BYTE PTR [DI], ':'
    INC DI
    MOV AL, AUDIT_MINUTE
    CALL AUDIT_WRITE_TWO
    MOV BYTE PTR [DI], ':'
    INC DI
    MOV AL, AUDIT_SECOND
    CALL AUDIT_WRITE_TWO
    MOV BYTE PTR [DI], ' '
    INC DI
    MOV SI, OFFSET AUDIT_USER
    MOV CX, 4
    REP MOVSB
    MOV BYTE PTR [DI], ' '
    INC DI
    MOV SI, AUDIT_ACTION_PTR
    CALL AUDIT_COPY_DOLLAR
    MOV BYTE PTR [DI], ' '
    INC DI
    MOV SI, OFFSET AUDIT_ACCOUNT
    CALL AUDIT_COPY_DOLLAR
    MOV BYTE PTR [DI], ' '
    INC DI
    MOV SI, AUDIT_DETAIL_PTR
    CALL AUDIT_COPY_DOLLAR
    MOV BYTE PTR [DI], 0Dh
    INC DI
    MOV BYTE PTR [DI], 0Ah
    INC DI
    MOV AUDIT_LENGTH, DI
    SUB AUDIT_LENGTH, OFFSET AUDIT_LINE
    MOV DX, OFFSET AUDIT_FILE_NAME
    MOV AX, 3D02h
    INT 21h
    JNC AUDIT_WRITE_OPENED
    CMP AX, 2
    JE AUDIT_WRITE_CREATE
    CMP AX, 3
    JE AUDIT_WRITE_CREATE
    JMP AUDIT_WRITE_DONE
AUDIT_WRITE_CREATE:
    MOV DX, OFFSET AUDIT_FILE_NAME
    XOR CX, CX
    MOV AH, 3Ch
    INT 21h
    JC AUDIT_WRITE_DONE
AUDIT_WRITE_OPENED:
    MOV AUDIT_HANDLE, AX
    MOV BX, AX
    MOV AX, 4202h
    XOR CX, CX
    XOR DX, DX
    INT 21h
    JC AUDIT_WRITE_CLOSE
    MOV BX, AUDIT_HANDLE
    MOV CX, AUDIT_LENGTH
    MOV DX, OFFSET AUDIT_LINE
    MOV AH, 40h
    INT 21h
    JC AUDIT_WRITE_CLOSE
    CMP AX, AUDIT_LENGTH
    JNE AUDIT_WRITE_CLOSE
    MOV AUDIT_STATUS, 0
AUDIT_WRITE_CLOSE:
    MOV BX, AUDIT_HANDLE
    MOV AH, 3Eh
    INT 21h
    JNC AUDIT_WRITE_DONE
    MOV AUDIT_STATUS, 1
AUDIT_WRITE_DONE:
    CMP AUDIT_STATUS, 0
    JE AUDIT_WRITE_RETURN
    MOV DX, OFFSET MSG_AUDIT_FAILED
    CALL PRINT_STRING
AUDIT_WRITE_RETURN:
    MOV AL, AUDIT_STATUS
    POP ES
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
AUDIT_WRITE ENDP

; Purpose: Copy a '$'-terminated string to the current audit-line position.
; Inputs: DS:SI is the source and ES:DI is the destination.
; Outputs: Copies bytes before '$'; SI and DI point at their respective terminators.
; Registers: Preserves BX, CX, DX, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: LODSB, STOSB, and segment-specific string addressing.
AUDIT_COPY_DOLLAR PROC NEAR
    PUSHF
    CLD
AUDIT_COPY_DOLLAR_NEXT:
    LODSB
    CMP AL, '$'
    JE AUDIT_COPY_DOLLAR_DONE
    STOSB
    JMP AUDIT_COPY_DOLLAR_NEXT
AUDIT_COPY_DOLLAR_DONE:
    POPF
    RET
AUDIT_COPY_DOLLAR ENDP

; Purpose: Write a two-digit decimal byte at the audit-line destination.
; Inputs: AL is an unsigned value from 0 through 99; ES:DI is the destination.
; Outputs: Writes two ASCII digits and advances DI by two.
; Registers: Preserves BX, CX, DX, SI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: DIV and ES-based register-indirect addressing.
AUDIT_WRITE_TWO PROC NEAR
    PUSH BX
    MOV BL, 10
    XOR AH, AH
    DIV BL
    ADD AL, '0'
    MOV ES:[DI], AL
    INC DI
    MOV AL, AH
    ADD AL, '0'
    MOV ES:[DI], AL
    INC DI
    POP BX
    RET
AUDIT_WRITE_TWO ENDP

; Purpose: Write the year as four decimal digits at the audit-line destination.
; Inputs: AX is a four-digit year; ES:DI is the destination.
; Outputs: Writes four ASCII digits and advances DI by four.
; Registers: Preserves BX, CX, DX, SI, BP, DS, and ES; destroys AX.
; Flags: Unspecified.
; ISA: DIV, PUSH/POP, and ES-based register-indirect addressing.
AUDIT_WRITE_YEAR PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    MOV BX, 10
    MOV CX, 4
AUDIT_WRITE_YEAR_SPLIT:
    XOR DX, DX
    DIV BX
    PUSH DX
    LOOP AUDIT_WRITE_YEAR_SPLIT
    MOV CX, 4
AUDIT_WRITE_YEAR_EMIT:
    POP DX
    MOV AL, DL
    ADD AL, '0'
    MOV ES:[DI], AL
    INC DI
    LOOP AUDIT_WRITE_YEAR_EMIT
    POP DX
    POP CX
    POP BX
    RET
AUDIT_WRITE_YEAR ENDP
