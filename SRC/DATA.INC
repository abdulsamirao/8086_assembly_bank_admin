.8086

.data
DATA_FILE_NAME      DB 'ACCOUNTS.DAT', 0
AUDIT_FILE_NAME     DB 'AUDIT.LOG', 0
DATA_MAGIC          DB 'CALD'
DATA_IMAGE          DB 152 DUP(0)
DATA_PIN_TEMP       DB 4 DUP(0)
DATA_LENGTH         DW 0
DATA_FILE_SIZE      DW 0
DATA_REMAINING       DW 0
DATA_HANDLE          DW 0
DATA_ERROR           DW 0
DATA_STATUS          DB 0

DATA_HEADER_SIZE     EQU 6
DATA_ADMIN_OFFSET    EQU 6
DATA_ACCOUNT_OFFSET  EQU 22
DATA_RECORD_SIZE     EQU 16
DATA_MAX_ACCOUNTS    EQU 8
DATA_IMAGE_MAX       EQU 152

.code

; Purpose: Hash four PIN digits with the four-byte account ID.
; Inputs: DS:SI points to a four-byte ASCII ID; DS:DI to four PIN digits.
; Outputs: AX is the 16-bit non-cryptographic hash; the PIN bytes are cleared.
; Registers: Preserves BX, CX, DX, SI, DI, ES; destroys AX.
; Flags: Unspecified.
; ISA: ROL by one, XOR, ADD, MUL, REP STOSB, and register-indirect addressing.
PIN_HASH PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH ES
    MOV AX, 6D31h
    MOV CX, 4
PIN_HASH_NEXT:
    ROL AX, 1
    XOR AL, [SI]
    ADD AX, 0137h
    XOR AH, [DI]
    INC SI
    INC DI
    LOOP PIN_HASH_NEXT
    MOV BX, 251
    MUL BX
    PUSH AX
    SUB DI, 4
    PUSH DS
    POP ES
    MOV CX, 4
    XOR AL, AL
    CLD
    REP STOSB
    POP AX
    POP ES
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
PIN_HASH ENDP

; Purpose: Compare a candidate PIN hash with a stored 16-bit hash.
; Inputs: DS:SI points to a four-byte ID; DS:DI to four PIN digits; BX is stored hash.
; Outputs: AL=1 for a match or AL=0 for a mismatch; the PIN bytes are cleared.
; Registers: Preserves BX, CX, DX, SI, DI, ES; destroys AX.
; Flags: Unspecified.
; ISA: CMP, conditional branch, and near CALL.
PIN_VERIFY PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH ES
    MOV DX, BX
    CALL PIN_HASH
    CMP AX, DX
    MOV AL, 0
    JNE PIN_VERIFY_DONE
    INC AL
PIN_VERIFY_DONE:
    POP ES
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
PIN_VERIFY ENDP

; Purpose: Sum the current file image, excluding its two checksum bytes.
; Inputs: DATA_LENGTH is the complete image size; it must be at least two.
; Outputs: DX receives the unsigned 16-bit additive checksum.
; Registers: Preserves AX, CX, SI; destroys DX.
; Flags: Unspecified.
; ISA: ADD and register-indirect addressing.
DATA_COMPUTE_CHECKSUM PROC NEAR
    PUSH AX
    PUSH CX
    PUSH SI
    MOV CX, DATA_LENGTH
    SUB CX, 2
    MOV SI, OFFSET DATA_IMAGE
    XOR DX, DX
DATA_CHECKSUM_NEXT:
    XOR AX, AX
    MOV AL, [SI]
    ADD DX, AX
    INC SI
    LOOP DATA_CHECKSUM_NEXT
    POP SI
    POP CX
    POP AX
    RET
DATA_COMPUTE_CHECKSUM ENDP

; Purpose: Write the current bounded data image to ACCOUNTS.DAT.
; Inputs: DATA_IMAGE contains the header and records; byte 5 is the count.
; Outputs: AL=0 on success or AL=1 on a DOS or format error.
; Registers: Preserves BX, CX, DX, SI, DI; destroys AX.
; Flags: Unspecified.
; ISA: INT 21h/AH=3Ch, AH=40h, AH=3Eh, and register-indirect addressing.
DATA_SAVE PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    MOV DATA_STATUS, 1
    MOV AL, DATA_IMAGE+5
    CMP AL, DATA_MAX_ACCOUNTS
    JBE DATA_SAVE_COUNT_OK
    JMP DATA_SAVE_RETURN
DATA_SAVE_COUNT_OK:
    XOR AH, AH
    MOV CL, 4
    SHL AX, CL
    ADD AX, 24
    MOV DATA_LENGTH, AX
    CALL DATA_COMPUTE_CHECKSUM
    MOV BX, DATA_LENGTH
    SUB BX, 2
    MOV SI, OFFSET DATA_IMAGE
    ADD SI, BX
    MOV [SI], DL
    MOV [SI+1], DH
    MOV DX, OFFSET DATA_FILE_NAME
    XOR CX, CX
    MOV AH, 3Ch
    INT 21h
    JNC DATA_SAVE_CREATED
    MOV DATA_ERROR, AX
    JMP DATA_SAVE_RETURN
DATA_SAVE_CREATED:
    MOV DATA_HANDLE, AX
    MOV BX, AX
    MOV CX, DATA_LENGTH
    MOV DX, OFFSET DATA_IMAGE
    MOV AH, 40h
    INT 21h
    JNC DATA_SAVE_WRITE_OK
    MOV DATA_ERROR, AX
    JMP DATA_SAVE_CLOSE
DATA_SAVE_WRITE_OK:
    CMP AX, DATA_LENGTH
    JE DATA_SAVE_FULL_WRITE
    MOV DATA_ERROR, 0
    JMP DATA_SAVE_CLOSE
DATA_SAVE_FULL_WRITE:
    MOV DATA_STATUS, 0
DATA_SAVE_CLOSE:
    MOV BX, DATA_HANDLE
    MOV AH, 3Eh
    INT 21h
    JNC DATA_SAVE_CLOSED
    MOV DATA_ERROR, AX
    MOV DATA_STATUS, 1
    JMP DATA_SAVE_RETURN
DATA_SAVE_CLOSED:
    JMP DATA_SAVE_RETURN
DATA_SAVE_RETURN:
    MOV AL, DATA_STATUS
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
DATA_SAVE ENDP

; Purpose: Load and validate ACCOUNTS.DAT into the shared data image.
; Inputs: None; the DOS current directory supplies the data file.
; Outputs: AL=0 success, 1 missing, 2 corrupt, or 3 DOS I/O failure.
; Registers: Preserves BX, CX, DX, SI, DI, ES; destroys AX.
; Flags: Unspecified.
; ISA: INT 21h/AH=3Dh, AH=42h, AH=3Fh, AH=3Eh, and based addressing.
DATA_LOAD PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH ES
    MOV DATA_STATUS, 3
    MOV DX, OFFSET DATA_FILE_NAME
    MOV AX, 3D00h
    INT 21h
    JNC DATA_LOAD_OPENED
    MOV DATA_ERROR, AX
    CMP AX, 2
    JE DATA_LOAD_MISSING
    CMP AX, 3
    JE DATA_LOAD_MISSING
    JMP DATA_LOAD_RETURN
DATA_LOAD_MISSING:
    MOV DATA_STATUS, 1
    JMP DATA_LOAD_RETURN
DATA_LOAD_OPENED:
    MOV DATA_HANDLE, AX
    MOV DATA_STATUS, 0
    MOV BX, AX
    MOV AX, 4202h
    XOR CX, CX
    XOR DX, DX
    INT 21h
    JNC DATA_LOAD_SIZE_OK
    MOV DATA_ERROR, AX
    MOV DATA_STATUS, 3
    JMP DATA_LOAD_CLOSE
DATA_LOAD_SIZE_OK:
    OR DX, DX
    JZ DATA_LOAD_SIZE_LOW
    JMP DATA_LOAD_CORRUPT
DATA_LOAD_SIZE_LOW:
    CMP AX, 24
    JAE DATA_LOAD_SIZE_MIN_OK
    JMP DATA_LOAD_CORRUPT
DATA_LOAD_SIZE_MIN_OK:
    CMP AX, DATA_IMAGE_MAX
    JBE DATA_LOAD_SIZE_MAX_OK
    JMP DATA_LOAD_CORRUPT
DATA_LOAD_SIZE_MAX_OK:
    MOV DATA_FILE_SIZE, AX
    MOV BX, DATA_HANDLE
    MOV AX, 4200h
    XOR CX, CX
    XOR DX, DX
    INT 21h
    JNC DATA_LOAD_SEEK_OK
    MOV DATA_ERROR, AX
    MOV DATA_STATUS, 3
    JMP DATA_LOAD_CLOSE
DATA_LOAD_SEEK_OK:
    MOV BX, DATA_HANDLE
    MOV CX, DATA_HEADER_SIZE
    MOV DX, OFFSET DATA_IMAGE
    MOV AH, 3Fh
    INT 21h
    JNC DATA_LOAD_HEADER_READ
    MOV DATA_ERROR, AX
    MOV DATA_STATUS, 3
    JMP DATA_LOAD_CLOSE
DATA_LOAD_HEADER_READ:
    CMP AX, DATA_HEADER_SIZE
    JE DATA_LOAD_HEADER_SIZE_OK
    JMP DATA_LOAD_CORRUPT
DATA_LOAD_HEADER_SIZE_OK:
    CMP BYTE PTR DATA_IMAGE, 'C'
    JNE DATA_LOAD_CORRUPT
    CMP BYTE PTR DATA_IMAGE+1, 'A'
    JNE DATA_LOAD_CORRUPT
    CMP BYTE PTR DATA_IMAGE+2, 'L'
    JNE DATA_LOAD_CORRUPT
    CMP BYTE PTR DATA_IMAGE+3, 'D'
    JNE DATA_LOAD_CORRUPT
    CMP BYTE PTR DATA_IMAGE+4, 1
    JNE DATA_LOAD_CORRUPT
    MOV AL, DATA_IMAGE+5
    CMP AL, DATA_MAX_ACCOUNTS
    JBE DATA_LOAD_COUNT_OK
    JMP DATA_LOAD_CORRUPT
DATA_LOAD_COUNT_OK:
    XOR AH, AH
    MOV CL, 4
    SHL AX, CL
    ADD AX, 24
    MOV DATA_LENGTH, AX
    CMP AX, DATA_FILE_SIZE
    JE DATA_LOAD_EXPECTED_SIZE
    JMP DATA_LOAD_CORRUPT
DATA_LOAD_EXPECTED_SIZE:
    SUB AX, DATA_HEADER_SIZE
    MOV DATA_REMAINING, AX
    MOV BX, DATA_HANDLE
    MOV CX, DATA_REMAINING
    MOV DX, OFFSET DATA_IMAGE+DATA_HEADER_SIZE
    MOV AH, 3Fh
    INT 21h
    JNC DATA_LOAD_BODY_READ
    MOV DATA_ERROR, AX
    MOV DATA_STATUS, 3
    JMP DATA_LOAD_CLOSE
DATA_LOAD_BODY_READ:
    CMP AX, DATA_REMAINING
    JE DATA_LOAD_BODY_SIZE_OK
    JMP DATA_LOAD_CORRUPT
DATA_LOAD_BODY_SIZE_OK:
    JMP DATA_LOAD_CLOSE
DATA_LOAD_CORRUPT:
    MOV DATA_STATUS, 2
DATA_LOAD_CLOSE:
    MOV BX, DATA_HANDLE
    MOV AH, 3Eh
    INT 21h
    JNC DATA_LOAD_CLOSED
    MOV DATA_ERROR, AX
    CMP DATA_STATUS, 0
    JNE DATA_LOAD_RETURN
    MOV DATA_STATUS, 3
    JMP DATA_LOAD_RETURN
DATA_LOAD_CLOSED:
    CMP DATA_STATUS, 0
    JNE DATA_LOAD_RETURN
    CALL DATA_COMPUTE_CHECKSUM
    MOV BX, DATA_LENGTH
    SUB BX, 2
    MOV SI, OFFSET DATA_IMAGE
    ADD SI, BX
    CMP DL, [SI]
    JNE DATA_LOAD_BAD_CHECKSUM
    CMP DH, [SI+1]
    JNE DATA_LOAD_BAD_CHECKSUM
    JMP DATA_LOAD_RETURN
DATA_LOAD_BAD_CHECKSUM:
    MOV DATA_STATUS, 2
DATA_LOAD_RETURN:
    MOV AL, DATA_STATUS
    POP ES
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
DATA_LOAD ENDP

; Purpose: Build the three specified seed records and initialize the files.
; Inputs: None.
; Outputs: AL=0 when ACCOUNTS.DAT is saved; AL=1 on a DOS failure.
; Registers: Preserves BX, CX, DX, SI, DI, ES; destroys AX.
; Flags: Unspecified.
; ISA: REP STOSB, INT 21h/AH=41h, and near CALL.
DATA_INIT PROC NEAR
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH ES
    PUSH DS
    POP ES
    CLD
    MOV DI, OFFSET DATA_IMAGE
    MOV CX, DATA_IMAGE_MAX
    XOR AX, AX
    REP STOSB
    MOV BYTE PTR DATA_IMAGE, 'C'
    MOV BYTE PTR DATA_IMAGE+1, 'A'
    MOV BYTE PTR DATA_IMAGE+2, 'L'
    MOV BYTE PTR DATA_IMAGE+3, 'D'
    MOV BYTE PTR DATA_IMAGE+4, 1
    MOV BYTE PTR DATA_IMAGE+5, 3

    MOV BYTE PTR DATA_IMAGE+6, '9'
    MOV BYTE PTR DATA_IMAGE+7, '0'
    MOV BYTE PTR DATA_IMAGE+8, '0'
    MOV BYTE PTR DATA_IMAGE+9, '1'
    MOV BYTE PTR DATA_PIN_TEMP, '1'
    MOV BYTE PTR DATA_PIN_TEMP+1, '3'
    MOV BYTE PTR DATA_PIN_TEMP+2, '5'
    MOV BYTE PTR DATA_PIN_TEMP+3, '7'
    MOV SI, OFFSET DATA_IMAGE+6
    MOV DI, OFFSET DATA_PIN_TEMP
    CALL PIN_HASH
    MOV WORD PTR DATA_IMAGE+10, AX

    MOV BYTE PTR DATA_IMAGE+22, '1'
    MOV BYTE PTR DATA_IMAGE+23, '0'
    MOV BYTE PTR DATA_IMAGE+24, '0'
    MOV BYTE PTR DATA_IMAGE+25, '1'
    MOV BYTE PTR DATA_PIN_TEMP, '1'
    MOV BYTE PTR DATA_PIN_TEMP+1, '2'
    MOV BYTE PTR DATA_PIN_TEMP+2, '3'
    MOV BYTE PTR DATA_PIN_TEMP+3, '4'
    MOV SI, OFFSET DATA_IMAGE+22
    MOV DI, OFFSET DATA_PIN_TEMP
    CALL PIN_HASH
    MOV WORD PTR DATA_IMAGE+26, AX
    MOV BYTE PTR DATA_IMAGE+28, 00h
    MOV BYTE PTR DATA_IMAGE+29, 00h
    MOV BYTE PTR DATA_IMAGE+30, 10h
    MOV BYTE PTR DATA_IMAGE+34, 1

    MOV BYTE PTR DATA_IMAGE+38, '1'
    MOV BYTE PTR DATA_IMAGE+39, '0'
    MOV BYTE PTR DATA_IMAGE+40, '0'
    MOV BYTE PTR DATA_IMAGE+41, '2'
    MOV BYTE PTR DATA_PIN_TEMP, '4'
    MOV BYTE PTR DATA_PIN_TEMP+1, '3'
    MOV BYTE PTR DATA_PIN_TEMP+2, '2'
    MOV BYTE PTR DATA_PIN_TEMP+3, '1'
    MOV SI, OFFSET DATA_IMAGE+38
    MOV DI, OFFSET DATA_PIN_TEMP
    CALL PIN_HASH
    MOV WORD PTR DATA_IMAGE+42, AX
    MOV BYTE PTR DATA_IMAGE+44, 75h
    MOV BYTE PTR DATA_IMAGE+45, 50h
    MOV BYTE PTR DATA_IMAGE+46, 02h
    MOV BYTE PTR DATA_IMAGE+50, 1

    MOV BYTE PTR DATA_IMAGE+54, '1'
    MOV BYTE PTR DATA_IMAGE+55, '0'
    MOV BYTE PTR DATA_IMAGE+56, '0'
    MOV BYTE PTR DATA_IMAGE+57, '3'
    MOV BYTE PTR DATA_PIN_TEMP, '1'
    MOV BYTE PTR DATA_PIN_TEMP+1, '1'
    MOV BYTE PTR DATA_PIN_TEMP+2, '1'
    MOV BYTE PTR DATA_PIN_TEMP+3, '1'
    MOV SI, OFFSET DATA_IMAGE+54
    MOV DI, OFFSET DATA_PIN_TEMP
    CALL PIN_HASH
    MOV WORD PTR DATA_IMAGE+58, AX
    MOV BYTE PTR DATA_IMAGE+66, 0

    CALL DATA_SAVE
    MOV DATA_STATUS, AL
    OR AL, AL
    JNZ DATA_INIT_RETURN
    MOV DX, OFFSET AUDIT_FILE_NAME
    MOV AH, 41h
    INT 21h
    JNC DATA_INIT_AUDIT_DONE
    CMP AX, 2
    JE DATA_INIT_AUDIT_DONE
    CMP AX, 3
    JE DATA_INIT_AUDIT_DONE
    MOV DATA_ERROR, AX
    MOV DATA_STATUS, 1
    JMP DATA_INIT_RETURN
DATA_INIT_AUDIT_DONE:
    MOV DATA_STATUS, 0
DATA_INIT_RETURN:
    MOV AL, DATA_STATUS
    POP ES
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
DATA_INIT ENDP
