@echo off
echo STAGE0_ASSEMBLE >> C:\TOOLS\BUILD.OUT
cd C:\TOOLS
if not exist C:\TOOLS\TASM\TASM.EXE goto BUILD_FAILED

for %%F in (*.ASM) do C:\TOOLS\TASM\TASM.EXE /zi /m %%F >> C:\TOOLS\BUILD.OUT
if errorlevel 1 goto BUILD_FAILED

echo STAGE0_LINK >> C:\TOOLS\BUILD.OUT
for %%F in (*.OBJ) do C:\TOOLS\TASM\TLINK.EXE /v %%F >> C:\TOOLS\BUILD.OUT
if errorlevel 1 goto BUILD_FAILED

cd C:\SRC
C:\TOOLS\TASM\TASM.EXE /zi /m BANK.ASM >> C:\TOOLS\BUILD.OUT
if errorlevel 1 goto BUILD_FAILED
C:\TOOLS\TASM\TLINK.EXE /v BANK.OBJ >> C:\TOOLS\BUILD.OUT
if errorlevel 1 goto BUILD_FAILED
copy C:\SRC\BANK.EXE C:\TOOLS\BANK.EXE >nul
if not exist C:\TOOLS\BANK.EXE goto BUILD_FAILED
goto BUILD_DONE

:BUILD_FAILED
echo BUILD_FAILED > C:\TOOLS\BUILD.ERR

:BUILD_DONE
