@echo off

if not exist C:\TOOLS\TASM\TASM.EXE goto BUILD_FAILED
cd C:\TOOLS
C:\TOOLS\TASM\TASM.EXE /zi /m HELLO.ASM
if errorlevel 1 goto BUILD_FAILED
C:\TOOLS\TASM\TLINK.EXE /v HELLO.OBJ
if errorlevel 1 goto BUILD_FAILED
C:\TOOLS\TASM\TASM.EXE /zi /m READKEY.ASM
if errorlevel 1 goto BUILD_FAILED
C:\TOOLS\TASM\TLINK.EXE /v READKEY.OBJ
if errorlevel 1 goto BUILD_FAILED
goto BUILD_DONE

:BUILD_FAILED
echo BUILD_FAILED > C:\TOOLS\BUILD.ERR

:BUILD_DONE
