@echo off
cd C:\TOOLS\CHK8086
C:\TOOLS\TASM\TASM.EXE /l /m BADPUSHA.ASM > BADPUSHA.OUT
if errorlevel 1 goto PUSHA_REJECTED
echo ACCEPTED > BADPUSHA.RES
goto PUSHA_DONE
:PUSHA_REJECTED
echo REJECTED > BADPUSHA.RES
:PUSHA_DONE
C:\TOOLS\TASM\TASM.EXE /l /m BADSHIFT.ASM > BADSHIFT.OUT
if errorlevel 1 goto SHIFT_REJECTED
echo ACCEPTED > BADSHIFT.RES
goto SHIFT_DONE
:SHIFT_REJECTED
echo REJECTED > BADSHIFT.RES
:SHIFT_DONE
C:\TOOLS\TASM\TASM.EXE /l /m BADOPS.ASM > BADOPS.OUT
if errorlevel 1 goto OPS_REJECTED
echo ACCEPTED > BADOPS.RES
goto OPS_DONE
:OPS_REJECTED
echo REJECTED > BADOPS.RES
:OPS_DONE
cd C:\TOOLS
